<mujoco model="arm_test">
<default>
  <joint damping="2" armature="0.01"/>
</default>
 <worldbody>
    <light pos="0 0 3"/>
    <geom type="plane" size="2 2 0.1"/>

<geom name="wall" type="box" pos="0.45 0 0.2" size="0.05 0.4 0.2" rgba="0.8 0.3 0.3 1"/>
<site name="target" pos="0.7 0 0.1" size="0.03" rgba="0.2 0.9 0.2 1"/>

 <body name="upper" pos="0 0 0.5">
  <joint name="j1" type="hinge" axis="0 0 1" range="-180 180" damping="2"/>  <!-- 根本 ヨー-->
  <joint name="j2" type="hinge" axis="0 1 0" range="-90 90"  damping="2"/>  <!-- 肩ピッチ -->
  <geom type="capsule" fromto="0 0 0  0.4 0 0" size="0.03"/>

  <body name="fore" pos="0.4 0 0">
  <joint name="j3" type="hinge" axis="0 1 0" range="-150 150" damping="2"/>  <!-- 肘ピッチ -->
  <geom type="capsule" fromto="0 0 0  0.4 0 0" size="0.025"/>

  <body name="hand" pos="0.4 0 0">
  <joint name="j4" type="hinge" axis="1 0 0" range="-180 180" damping="2"/>  <!-- 前腕ロール -->
  <joint name="j5" type="hinge" axis="0 1 0" range="-90 90"  damping="2"/>  <!-- 手首ピッチ-->
  <joint name="j6" type="hinge" axis="1 0 0" range="-90 90"  damping="2"/>  <!-- 手先ロール -->
  <geom type="capsule" fromto="0 0 0  0.1 0 0" size="0.02"/>
  <site name="tip" pos="0.1 0 0" size="0.02"/> 
 


    </body>   
    </body>
    </body>
  </worldbody>
  <actuator>
    <position joint="j1" kp="50"/>
    <position joint="j2" kp="50"/>
    <position joint="j3" kp="50"/>
    <position joint="j4" kp="50"/>
    <position joint="j5" kp="50"/>
    <position joint="j6" kp="50"/>
  </actuator>
</mujoco>
